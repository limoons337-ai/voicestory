# ── VoxRPG 백엔드 설정 ─────────────────────────────────────────
# 이 파일을 복사해서 .env 로 저장하세요.

# LLM 백엔드 (OpenAI 호환 규격). 기본값 = 로컬 Ollama.
#   개발/베타 : http://localhost:11434/v1   (Ollama, 무료)
#   클라우드  : https://api.openai.com/v1  등 OpenAI 호환 게이트웨이
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=exaone3.5
LLM_API_KEY=

# LLM 없이 UI만 테스트하려면 1 로 (정해진 목 응답 반환)
LLM_MOCK=0

# 서버 포트
PORT=8787

# 무료 티어 하루 턴 제한
FREE_DAILY_TURNS=30

# GM 응답 최대 토큰 (짧게 유지 → TTS 친화 + 비용 절감)
MAX_TOKENS=320
